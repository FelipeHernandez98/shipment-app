# App
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shipments_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SCHEMA=public

# Auth
JWT_SECRET=replace-with-a-secure-secret

# Cloudflare R2 (Phase 2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
